{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QuotaSpark",
  "version": "0.1.0",
  "identifier": "com.self.ccactivator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "额度火花 QuotaSpark",
        "width": 1020,
        "height": 720,
        "minWidth": 860,
        "minHeight": 560,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/tuxin-labs/quotaspark/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDFCMEVBNjZBNEM4NjIyMDAKUldRQUlvWk1hcVlPRzFWM1ZFdjlpRnZaWE81M2ZMVm5kWjE1Sjd3VnRpZG5obkQ4YjVQWFoxQy8K"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
